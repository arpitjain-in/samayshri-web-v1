rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Visits collection - allow public writes (form submissions), no reads
    match /visits/{visitId} {
      // Allow anyone to create a visit request
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'visitDate', 'numberOfVisitors']) 
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.visitDate is string
                    && request.resource.data.numberOfVisitors is string;
      
      // Only authenticated admins can read/update/delete
      // For now, disable read/update/delete - add authentication later
      allow read, update, delete: if false;
    }
    
    // Google accounts allowed to edit the rate card on rates.samayshri.com/admin
    function isRateAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['samayshriagro@gmail.com'];
    }
    
    // Current rate card - anyone can read, only admins can save
    match /rateCard/{docId} {
      allow read: if true;
      allow create, update: if isRateAdmin()
                            && request.resource.data.json is string
                            && request.resource.data.json.size() < 100000;
    }
    
    // Every saved version of the rate card - admins only, and entries can never be changed or deleted
    match /rateHistory/{entryId} {
      allow read: if isRateAdmin();
      allow create: if isRateAdmin()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() < 100000
                    && request.resource.data.savedBy == request.auth.token.email
                    && request.resource.data.savedAt == request.time;
    }
    
    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
